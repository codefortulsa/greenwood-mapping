// VS Code / Codespaces dev container.
// The real compose file + Dockerfile live at the project root; this just
// points VS Code at them so the in-container dev experience uses the same
// image everyone else gets.
{
    "name": "Greenwood History Store",
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "app",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-azuretools.vscode-docker",
                "tamasfe.even-better-toml",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "forwardPorts": [8000, 3000, 5432, 6379],
    "postCreateCommand": "poetry install"
}
