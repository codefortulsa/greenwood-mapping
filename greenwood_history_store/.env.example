# Copy to .env and customize. `.env` is gitignored.

# Django -------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-something-long-and-random
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional overrides (uncomment to change from compose defaults)
# DJANGO_CONFIGURATION=Dev
# DATABASE_URL=postgis://postgres:postgres@db:5432/greenwood_history
# CACHE_URL=django-redis://redis/0

