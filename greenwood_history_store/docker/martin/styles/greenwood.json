{
  "version": 8,
  "name": "Greenwood (OSM + overlays_mapfeature)",
  "center": [-95.989, 36.16],
  "zoom": 15,
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 19
    },
    "overlays_mapfeature": {
      "type": "vector",
      "url": "http://localhost:3000/overlays_mapfeature"
    }
  },
  "layers": [
    { "id": "osm-base", "type": "raster", "source": "osm" },
    {
      "id": "township-outline",
      "type": "line",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "township"],
      "paint": { "line-color": "#8b5cf6", "line-width": 0.6, "line-opacity": 0.4 }
    },
    {
      "id": "quarter_section-outline",
      "type": "line",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "quarter_section"],
      "paint": { "line-color": "#6366f1", "line-width": 0.5, "line-opacity": 0.4 }
    },
    {
      "id": "parcel-outline",
      "type": "line",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "parcel"],
      "paint": { "line-color": "#4b5563", "line-width": 0.5, "line-opacity": 0.6 }
    },
    {
      "id": "modern_building_footprint-outline",
      "type": "line",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "modern_building_footprint"],
      "paint": { "line-color": "#9ca3af", "line-width": 0.5 }
    },
    {
      "id": "historical_building-fill",
      "type": "fill",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "historical_building"],
      "paint": { "fill-color": "#374151", "fill-opacity": 0.4, "fill-outline-color": "#111827" }
    },
    {
      "id": "historical_road-line",
      "type": "line",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "historical_road"],
      "paint": { "line-color": "#92400e", "line-width": 2 }
    },
    {
      "id": "destruction_zone-fill",
      "type": "fill",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "destruction_zone"],
      "paint": { "fill-color": "#ef4444", "fill-opacity": 0.35, "fill-outline-color": "#991b1b" }
    },
    {
      "id": "poi_footprint-fill",
      "type": "fill",
      "source": "overlays_mapfeature",
      "source-layer": "overlays_mapfeature",
      "filter": ["==", ["get", "kind"], "poi_footprint"],
      "paint": { "fill-color": "#f97316", "fill-opacity": 0.65, "fill-outline-color": "#9a3412" }
    }
  ]
}
